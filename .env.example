# Every setting Shiptorio reads, with empty values. Nothing here is required for `?source=sim`.
#
# Server (Cloudflare Worker): these go in server/.dev.vars, which `bun run dev` creates for you from
# server/.dev.vars.example (the same keys as below). In production, set them as Worker secrets.

SESSION_SECRET=
# Required in production; protects the entire site, including static assets.
APP_PASSWORD=
# On localhost, /auth/login signs you in as this user without GitHub. Ignored anywhere else.
DEV_LOGIN=
# Meta Muse Spark 1.3 (Meta Model API). Without it, triage uses a keyword rule and nothing calls a model.
META_API_KEY=
# Dev/demo fallback only. Spark never codes on the product path; leave 0 or empty (off).
HOSTED_SPARK_ASSEMBLER=
# From /setup once your GitHub App exists, to load real repos locally.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The .pem GitHub gives you, as-is (PKCS#1 or PKCS#8).
GITHUB_APP_PRIVATE_KEY=
# Optional mines. Or paste them on /connect/sentry and /connect/posthog.
SENTRY_CLIENT_SECRET=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# 1 uses canned PostHog traffic data.
FAKE_POSTHOG=

# Local runner (your machine): set in the runner's environment.
# Muse Code is the only assembler offered by default.

# Optional geothermal plant: a Meta open-weight model (Muse Glimmer or Muse Spark Open) on a local server.
# Off when empty; any other model name is refused. URL defaults to Ollama's http://localhost:11434/v1.
SHIPTORIO_LOCAL_MODEL=
SHIPTORIO_LOCAL_MODEL_URL=
# Development only, off by default and never offered to players: set to 1 to let the runner use these CLIs.
SHIPTORIO_ENABLE_CODEX=
SHIPTORIO_ENABLE_CLAUDE=
