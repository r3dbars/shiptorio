{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiptorio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "shiptorio.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "FACTORY", "class_name": "Factory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Factory"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiptorio",
      "database_id": "153f63dc-f65f-4c02-a0b1-6c78b7d6aa08",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "c9d7c44e1c304a2b9a285049ee1e3408" }
  ],
  "vars": {
    "PUBLIC_URL": "https://shiptorio.com",
    // Comma-separated GitHub logins allowed to view maps.
    "ALLOWED_LOGINS": "r3dbars",
    "ADMIN_LOGINS": "r3dbars",
    // Verified existing mine owner: immutable GitHub identity, production only.
    "SENTRY_REPO": "r3dbars/shiptorio",
    "SENTRY_REPO_ID": "1434502633",
    "SENTRY_INSTALLATION_ID": "175555016",
    "POSTHOG_REPO": "r3dbars/shiptorio",
    "POSTHOG_REPO_ID": "1434502633",
    "POSTHOG_INSTALLATION_ID": "175555016",
    // Muse Spark on Meta Model API. Key goes in the META_API_KEY secret.
    "SPARK_BASE_URL": "https://api.meta.ai/v1",
    "SPARK_MODEL": "muse-spark-1.3"
  },
  "triggers": { "crons": ["17 4 * * *"] },
  "env": {
    "staging": {
      "name": "shiptorio-staging",
      "routes": [{ "pattern": "shiptorio.dev", "custom_domain": true }],
      "durable_objects": { "bindings": [{ "name": "FACTORY", "class_name": "Factory" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "shiptorio-staging", "database_id": "82bf6646-ed06-4c4d-94c3-c9b747940a7e", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "eb151c15e208446482ca39062005f4d9" }],
      "vars": {
        "PUBLIC_URL": "https://shiptorio.dev",
        "ALLOWED_LOGINS": "r3dbars",
        "ADMIN_LOGINS": "r3dbars",
        "SPARK_BASE_URL": "https://api.meta.ai/v1",
        "SPARK_MODEL": "muse-spark-1.3"
      }
    }
  }
  // Secrets (set with `wrangler secret put`, or .dev.vars locally). /setup prints all of them:
  //   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET,
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET, META_API_KEY, SHIPTORIO_SENTRY_DSN (Shiptorio itself, not the mine)
  // Optional var PUBLIC_URL overrides the URL used for GitHub callbacks (defaults to the request origin).
}
