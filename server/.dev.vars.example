# `bun run dev` copies this to .dev.vars the first time and fills in what it can.
SESSION_SECRET=
# Required in production; protects the entire site, including static assets.
APP_PASSWORD=
# On localhost, /auth/login signs you in as this user without GitHub. Ignored anywhere else.
DEV_LOGIN=
# Muse Spark (Meta Model API). Without it the splitter uses a heuristic and assemblers stay unpowered.
META_API_KEY=
# Dev/demo fallback only. Spark never codes on the product path; default is off.
HOSTED_SPARK_ASSEMBLER=0
# Fill these in from /setup once the GitHub App exists, to load real repos locally.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The .pem GitHub gives you, as-is (PKCS#1 or PKCS#8 both work)
GITHUB_APP_PRIVATE_KEY=""
# Sentry mine (optional; or paste it on /connect/sentry). Any fake value works with `bun run fake:sentry`.
SENTRY_CLIENT_SECRET=
# PostHog mine (optional; or paste it on /connect/posthog). FAKE_POSTHOG=1 uses canned traffic data.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
FAKE_POSTHOG=0
