{
  "name": "@shiptorio/server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-setup.ts && wrangler dev --infer-origin-from-routes=false",
    "deploy": "wrangler d1 migrations apply shiptorio --remote && wrangler d1 execute shiptorio --remote --file ops/production-owner.sql && wrangler deploy --name shiptorio --var BUILD_SHA:$(git rev-parse HEAD)",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.9.0",
    "@shiptorio/shared": "workspace:*",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.153.0"
  }
}
