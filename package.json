{
  "name": "shiptorio",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "runner",
    "playtest",
    "server",
    "web"
  ],
  "scripts": {
    "playtest": "bun playtest/src/run.ts",
    "runner:service": "bun runner/scripts/service.ts",
    "runner": "bun --env-file=runner/.dev.vars runner/src/cli.ts",
    "runner:control": "bun --env-file=server/.dev.vars server/scripts/runner-control.ts",
    "dev": "bun run build && bun run --filter './server' dev",
    "dev:web": "bun run --filter './web' dev",
    "build": "bun run --filter './web' build && bun scripts/build-runner.ts",
    "deploy": "bun run build && bun run --filter './server' deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "spark:check": "bun server/scripts/spark-check.ts",
    "fake:sentry": "bun --env-file=server/.dev.vars server/scripts/fake-sentry.ts",
    "autopilot": "bun --env-file=server/.dev.vars server/scripts/autopilot.ts",
    "fake:support": "bun --env-file=server/.dev.vars server/scripts/fake-support.ts",
    "stranger": "bun run build && node playtest/stranger/run.mjs"
  }
}
