{
  "name": "shiptorio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "runner",
    "playtest",
    "server",
    "web"
  ],
  "scripts": {
    "playtest": "bun playtest/src/run.ts",
    "runner:service": "bun runner/scripts/service.ts",
    "runner": "bun --env-file=runner/.dev.vars runner/src/cli.ts",
    "runner:control": "bun --env-file=server/.dev.vars server/scripts/runner-control.ts",
    "dev": "bun run build && bun run --filter './server' dev",
    "dev:web": "bun run --filter './web' dev",
    "build": "bun run --filter './web' build && bun scripts/build-runner.ts",
    "deploy": "bun run build && bun run --filter './server' deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:storage": "bun server/scripts/test-storage-host.ts",
    "test:parallel": "bun test --parallel=2",
    "check": "bun run lint:observability && bun run typecheck && bun test && bun run build",
    "spark:check": "bun server/scripts/spark-check.ts",
    "spark:loop": "bun server/scripts/spark-loop-check.ts",
    "spark:eval": "bun server/scripts/spark-eval.ts",
    "brain:eval": "bun server/scripts/brain-eval.ts",
    "fake:sentry": "bun --env-file=server/.dev.vars server/scripts/fake-sentry.ts",
    "test:fast": "bun run typecheck && bun run typecheck:tests && bun test && bun run playtest --check",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:load": "bun tests/load/run.ts",
    "typecheck:tests": "tsc --noEmit -p tests",
    "autopilot": "bun --env-file=server/.dev.vars server/scripts/autopilot.ts",
    "fake:support": "bun --env-file=server/.dev.vars server/scripts/fake-support.ts",
    "stranger": "bun run build && node playtest/stranger/run.mjs",
    "selfhost": "bun server/scripts/selfhost.ts",
    "lint:observability": "bun scripts/lint-observability.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  }
}
