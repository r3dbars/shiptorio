{
  "name": "shiptorio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply shiptorio --local",
    "db:migrate:remote": "wrangler d1 migrations apply shiptorio --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
