{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiptorio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/setup*"] },
  "durable_objects": {
    "bindings": [{ "name": "REPO_ROOM", "class_name": "RepoRoom" },
      { "name": "FACTORY", "class_name": "FactoryRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["FactoryRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiptorio",
      "database_id": "153f63dc-f65f-4c02-a0b1-6c78b7d6aa08",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "c9d7c44e1c304a2b9a285049ee1e3408" }
  ],
  "vars": {
    // Comma-separated GitHub logins allowed to view maps.
    "ALLOWED_LOGINS": "r3dbars"
  }
  // Secrets (set with `wrangler secret put`, or .dev.vars locally). /setup prints all of them:
  //   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET,
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET
  // Optional var PUBLIC_URL overrides the URL used for GitHub callbacks (defaults to the request origin).
}
